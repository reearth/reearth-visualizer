{
  "name": "@reearth/visualizer-plugin-api",
  "version": "0.1.0",
  "description": "TypeScript type definitions for the Re:Earth Visualizer plugin API",
  "reearthApiVersion": "2.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.d.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
