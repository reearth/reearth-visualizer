    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@reearth/core": ">=0.0.7-alpha.81"
  },
  "devDependencies": {
    "@reearth/core": "0.0.7-alpha.81",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
